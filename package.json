{
  "name": "blog-web",
  "version": "2.0.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "eslint": "9.19.0",
    "eslint-plugin-vue": "10.0.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "postcss-html": "1.7.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.5.3",
    "stylelint": "16.14.1",
    "stylelint-config-standard-scss": "14.0.0",
    "typescript-eslint": "8.22.0",
    "vue-eslint-parser": "10.2.0"
  },
  "description": "Engineering Showcase and Developer Playground frontend monorepo",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "9.15.5"
  },
  "scripts": {
    "dev": "pnpm dev:vite",
    "dev:vite": "pnpm --filter @blog/web dev:vite",
    "dev:webpack": "pnpm --filter @blog/web dev:webpack",
    "build": "pnpm build:vite",
    "build:vite": "pnpm --filter @blog/web build:vite",
    "build:webpack": "pnpm --filter @blog/web build:webpack",
    "analyze:webpack": "pnpm --filter @blog/web analyze:webpack",
    "analyze:vite": "pnpm --filter @blog/web analyze:vite",
    "benchmark:build": "node scripts/build-benchmark/index.mjs",
    "build:docker": "node scripts/docker-build.mjs",
    "verify:ci:docker": "node scripts/ci-docker-check.mjs",
    "prepare": "husky",
    "typecheck": "pnpm --filter @blog/web typecheck",
    "check:config": "pnpm --filter @blog/web exec tsc --noEmit -p tsconfig.config.json",
    "check:editor": "pnpm check:config && pnpm typecheck && pnpm lint",
    "lint": "pnpm lint:script && pnpm lint:style",
    "lint:script": "eslint .",
    "lint:style": "stylelint \"apps/web/src/**/*.{css,scss,vue}\" \"packages/ui/src/**/*.vue\"",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @blog/web e2e"
  }
}
