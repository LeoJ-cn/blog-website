{
  "name": "blog-web",
  "version": "2.0.0",
  "private": true,
  "description": "Engineering Showcase and Developer Playground frontend monorepo",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "9.15.5"
  },
  "scripts": {
    "dev": "pnpm dev:vite",
    "dev:vite": "pnpm --filter @blog/web dev:vite",
    "dev:webpack": "pnpm --filter @blog/web dev:webpack",
    "build": "pnpm build:vite",
    "build:vite": "pnpm --filter @blog/web build:vite",
    "build:webpack": "pnpm --filter @blog/web build:webpack",
    "analyze:webpack": "pnpm --filter @blog/web analyze:webpack",
    "analyze:vite": "pnpm --filter @blog/web analyze:vite",
    "benchmark:build": "node scripts/build-benchmark/index.mjs",
    "typecheck": "pnpm --filter @blog/web typecheck",
    "lint": "echo 'Phase 1 placeholder: lint configuration will be added in a later phase.'",
    "test:e2e": "echo 'Phase 1 placeholder: Playwright will be added in a later phase.'"
  }
}
