{
  "name": "@white55/ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:vite": "vite build --config vite.config.ts && vue-tsc -p tsconfig.build.json && node scripts/copy-styles.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./button": "./src/entries/button.ts",
    "./input": "./src/entries/input.ts",
    "./select": "./src/entries/select.ts",
    "./dialog": "./src/entries/dialog.ts",
    "./loading": "./src/entries/loading.ts",
    "./empty-state": "./src/entries/empty-state.ts",
    "./form": "./src/entries/form.ts",
    "./table": "./src/entries/table.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./button.css": "./src/styles/button.css",
    "./input.css": "./src/styles/input.css",
    "./select.css": "./src/styles/select.css",
    "./dialog.css": "./src/styles/dialog.css",
    "./loading.css": "./src/styles/loading.css",
    "./empty-state.css": "./src/styles/empty-state.css",
    "./form.css": "./src/styles/form.css",
    "./table.css": "./src/styles/table.css"
  },
  "sideEffects": ["./src/styles/*.css"],
  "files": ["dist"],
  "peerDependencies": {
    "element-plus": "2.9.5",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "element-plus": "2.9.5",
    "typescript": "5.6.3",
    "vite": "6.0.11",
    "vue": "3.5.13",
    "vue-tsc": "2.2.0"
  }
}
